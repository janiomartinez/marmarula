# Copia este archivo como `.env` y ajusta los valores. `.env` nunca se sube a GitHub.
MARMARULA_ENVIRONMENT=development
# Número de WhatsApp que recibe los pedidos: código de país + número, solo dígitos.
MARMARULA_WHATSAPP_NUMBER=573000000000
MARMARULA_INSTAGRAM_USER=marmarula
MARMARULA_CURRENCY=COP
# En producción, lista JSON con los dominios permitidos:
# MARMARULA_ALLOWED_HOSTS=["marmarula.com","www.marmarula.com"]
